{
  "id": "./",
  "name": "Diagram Editor – BPMN, UML, Flowchart",
  "short_name": "Diagrams",
  "description": "Vẽ diagram dạng whiteboard cho thiết kế phần mềm: BPMN 2.0, UML 2.5, Flowchart và ERD. Dữ liệu JSON, xuất SVG/PNG, nhúng SVG vào Markdown. Chạy cả khi offline.",
  "lang": "vi",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "categories": ["productivity", "developer", "design", "business"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Diagram Editor đang vẽ một quy trình BPMN với Pool, Lane, Task và Gateway"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/json": [".json"], "text/markdown": [".md", ".markdown"] },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] }
}
