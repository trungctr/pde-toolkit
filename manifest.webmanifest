{
  "id": "./",
  "name": "ChillCat Studio – Tài liệu thiết kế phần mềm",
  "short_name": "ChillCat",
  "description": "Soạn tài liệu thiết kế phần mềm: 24 mẫu SRS, SDD, ERD, API, BPMN theo ISO/IEC/IEEE 12207 nối bằng mã truy vết; vẽ BPMN, UML, ERD nhúng vào Markdown; thiết kế trang web; chat AI. Chạy cả khi offline.",
  "lang": "vi",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "categories": [
    "productivity",
    "developer",
    "design",
    "business"
  ],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ChillCat Studio – chọn mẫu tài liệu thiết kế phần mềm (SRS, BPMN, SDD, ERD, API, kiểm thử)"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
