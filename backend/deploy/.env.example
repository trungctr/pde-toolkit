# Sao chép thành `.env` cạnh docker-compose.yml (không commit). Biến nào không đặt sẽ lấy mặc định trong compose.

# Bắt buộc – ít nhất 32 ký tự ngẫu nhiên. Đổi giá trị = mọi access token đang dùng mất hiệu lực (trình duyệt tự làm mới
# bằng refresh token, người dùng không phải đăng nhập lại). Muốn buộc mọi người đăng nhập lại: xem OPS-00 (xoá phiên).
# Mọi biến khác trong backend/.env.example cũng đặt được ở đây (AUDIT_RETENTION_DAYS, LOG_FORMAT, RUST_LOG…).
#   PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   Linux/macOS: openssl rand -hex 32
JWT_SECRET=

# Cổng trên máy chủ và địa chỉ người dùng mở (https:// ⇒ cookie đăng nhập có cờ Secure)
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Bỏ trống = dùng container mongo đi kèm. Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=
MONGODB_DB=chillcat

# Tài khoản quản trị đầu tiên (không đặt thì người đăng ký đầu tiên là quản trị)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
AUTH_ALLOW_REGISTRATION=true
WORKSPACE_CREATION=all

# Máy ít RAM (Docker Desktop < 4 GB): giảm số tiến trình biên dịch song song khi build ảnh
# CARGO_BUILD_JOBS=2

# none = so khớp từ khoá; anthropic = Claude (cần AI_API_KEY)
AI_PROVIDER=none
# AI_API_KEY=
