# Sao chép thành `.env` (không commit) rồi chỉnh. Mọi biến đều có thể đặt trực tiếp trong môi trường.

# dev | prod  (prod bắt buộc JWT_SECRET)
APP_ENV=dev
HTTP_ADDR=127.0.0.1:8080
# Địa chỉ người dùng mở ứng dụng – dùng cho link; https:// ⇒ cookie refresh có cờ Secure.
PUBLIC_BASE_URL=http://localhost:8080
# Thư mục giao diện tĩnh (index.html, js/, css/…). Bỏ trống = chỉ phục vụ API.
STATIC_DIR=..
# Giao diện ở tên miền khác (ví dụ GitHub Pages) – liệt kê origin, cách nhau bằng dấu phẩy.
# CORS_ALLOWED_ORIGINS=https://design.example.com

# ---------------------------------------------------------------- MongoDB
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=chillcat
# Cục bộ:  chạy scripts/dev-mongo.ps1 (replica set một node ở cổng 27117)
MONGODB_URI=mongodb://127.0.0.1:27117/?replicaSet=rs0&directConnection=true
MONGODB_DB=chillcat
# Tách CSDL theo module (bước đầu khi tách dịch vụ): MONGODB_DB_<MODULE>=<tên>
# MONGODB_DB_IDENTITY=chillcat_identity
# MONGODB_DB_DOCUMENTS=chillcat_documents
MONGODB_MAX_POOL=20
# Chỉ cho máy phát triển: tự khởi tạo replica set nếu mongod chưa có.
MONGODB_AUTO_INIT_REPLICA_SET=false

# ------------------------------------------------------------- Đăng nhập
# Ít nhất 32 ký tự ngẫu nhiên. Đổi giá trị = mọi access token đang dùng mất hiệu lực; phiên (refresh token, lưu băm trong
# collection sessions) vẫn còn nên người dùng không phải đăng nhập lại. Buộc đăng nhập lại: xoá phiên (docs OPS-00).
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_ALLOW_REGISTRATION=true
# Tài khoản quản trị đầu tiên (chỉ tạo khi chưa có quản trị viên nào). Không đặt thì người đăng ký đầu tiên là quản trị.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# all | admin  – ai được tạo workspace
WORKSPACE_CREATION=all

# ---------------------------------------------------------------------- AI
# none = kiểm tra trùng / đề xuất tài liệu bằng so khớp từ khoá; anthropic = Claude
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_BASE_URL=https://api.anthropic.com
AI_TIMEOUT_SECS=300
# Chạy lại trên model dự phòng khi yêu cầu bị bộ lọc an toàn từ chối (fallbacks: "default").
AI_FALLBACKS=true

# ------------------------------------------------------------- Lưu trữ
AUDIT_RETENTION_DAYS=730
VERSION_RETENTION_YEARS=10
INVITATION_TTL_DAYS=14

# info | debug | ...  (cú pháp tracing EnvFilter)
RUST_LOG=info,tower_http=info,mongodb=warn
# text | json
LOG_FORMAT=text
